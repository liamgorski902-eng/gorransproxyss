# Copy this file to ".env" and edit it. Never commit ".env".

# Port to listen on (hosting platforms usually set this for you).
PORT=3000

# REQUIRED for Proxy Mode. At least 32 random characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# REQUIRED for Proxy Mode. Comma-separated access codes (each at least 8 characters).
# Only people who know a code can use the proxy. If empty, Proxy Mode is disabled.
ACCESS_CODES=

# Destinations the proxy may fetch. A domain also covers its subdomains.
# Entries must contain a dot ("wikipedia.org"); "*" is rejected on purpose.
ALLOWED_HOSTS=wikipedia.org,wikimedia.org,wikisource.org,wolnelektury.pl,gutenberg.org,gov.pl,example.com,example.org

# How many reverse proxies sit in front of this app (Render/Railway/Fly = 1, local = 0).
# Used to read the real client IP from X-Forwarded-For for rate limiting.
TRUST_PROXY_HOPS=0

# Rate limits (per client IP).
PROXY_UNITS_PER_MIN=240
LOGIN_ATTEMPTS_PER_10_MIN=8

# Set to "production" when deployed (enables Secure cookies).
NODE_ENV=development
